"Specifes platform of game. Allowed values: 2gs, 3do, acorn, amiga, atari, c64, fmtowns, nes, mac, pc pc98, pce, segacd, wii, windows"
msgstr ""
"指定遊戲平台，可以是：2gs、3do、acorn、amiga、atari、c64、fmtowns、nes、mac、pc、pc98、pce、segacd、wii、windows"

#: lutris/runners/scummvm.py:270
msgid "Enables joystick input (default: 0 = first joystick)"
msgstr "啟用搖杆輸入（預設：0，即第一個搖杆）"

#: lutris/runners/scummvm.py:277
msgid ""
"Selects language (en, de, fr, it, pt, es, jp, zh, kr, se, gb, hb, ru, cz)"
msgstr "選擇語言（en、de、fr、it、pt、es、jp、zh、kr、se、gb、hb、ru、cz）"

#: lutris/runners/scummvm.py:283
msgid "Engine speed"
msgstr "引擎速度"

#: lutris/runners/scummvm.py:285
msgid ""
"Sets frames per second limit (0 - 100) for Grim Fandango or Escape from Monkey Island (default: 60)."
msgstr "為 Grim Fandango 和 Escape from Monkey Island 設定幀率限制（0 到 100，預設值：60）。"

#: lutris/runners/scummvm.py:292
msgid "Talk speed"
msgstr "對話速度"

#: lutris/runners/scummvm.py:293
msgid "Sets talk speed for games (default: 60)"
msgstr "設定遊戲中對話的呈現速度（預設：60）"

#: lutris/runners/scummvm.py:300
msgid "Music tempo"
msgstr "音樂速度"

#: lutris/runners/scummvm.py:301
msgid "Sets music tempo (in percent, 50-200) for SCUMM games (default: 100)"
msgstr "設定 SCUMM 遊戲中音樂的播放速度（百分比，50 到 200，預設值：100）"

#: lutris/runners/scummvm.py:308
msgid "Digital iMuse tempo"
msgstr "數字合成器速度"

#: lutris/runners/scummvm.py:309
msgid "Sets internal Digital iMuse tempo (10 - 100) per second (default: 10)"
msgstr "設定內部數位音樂合成器（iMuse）的運行速度（範圍：10 到 100，預設：10）"

#: lutris/runners/scummvm.py:315
msgid "Music driver"
msgstr "音頻驅動"

#: lutris/runners/scummvm.py:331
msgid "Specifies the device ScummVM uses to output audio."
msgstr "指定 ScummVM 使用的音頻輸出設備。"

#: lutris/runners/scummvm.py:337
msgid "Output rate"
msgstr "輸出採樣率"

#: lutris/runners/scummvm.py:344
msgid "Selects output sample rate in Hz."
msgstr "選擇音頻輸出的採樣率（Hz）。"

#: lutris/runners/scummvm.py:350
msgid "OPL driver"
msgstr "仿真音效卡"

#: lutris/runners/scummvm.py:363
msgid ""
"Chooses which emulator is used by ScummVM when the AdLib emulator is chosen as the Preferred device."
msgstr "當音頻驅動為 AdLib 音效卡時，在此處選擇模擬 AdLib 音效卡的方法。"

#: lutris/runners/scummvm.py:371
msgid "Music volume"
msgstr "音樂音量"

#: lutris/runners/scummvm.py:372
msgid "Sets the music volume, 0-255 (default: 192)"
msgstr "設定音樂的音量，從 0 到 255（預設：192）"

#: lutris/runners/scummvm.py:380
msgid "Sets the sfx volume, 0-255 (default: 192)"
msgstr "設定音效的音量，從 0 到 255（預設：192）"

#: lutris/runners/scummvm.py:387
msgid "Speech volume"
msgstr "對話音量"

#: lutris/runners/scummvm.py:388
msgid "Sets the speech volume, 0-255 (default: 192)"
msgstr "設定對話的音量，從 0 到 255（預設：192）"

#: lutris/runners/scummvm.py:395
msgid "MIDI gain"
msgstr "MIDI 增益"

#: lutris/runners/scummvm.py:396
msgid "Sets the gain for MIDI playback. 0-1000 (default: 100)"
msgstr "設定播放 MIDI 音樂時的音量增益，從 0 到 1000（預設：100）"

#: lutris/runners/scummvm.py:404
msgid "Specifies the path to a soundfont file."
msgstr "指定 MIDI 合成器使用的 SoundFont 音來源檔。"

#: lutris/runners/scummvm.py:410
msgid "Mixed AdLib/MIDI mode"
msgstr "AdLib/MIDI 混合模式"

#: lutris/runners/scummvm.py:413
msgid "Combines MIDI music with AdLib sound effects."
msgstr "混合使用 MIDI 音樂和 AdLib 音效。"

#: lutris/runners/scummvm.py:419
msgid "True Roland MT-32"
msgstr "原生 Roland MT-32 設備"

#: lutris/runners/scummvm.py:423
msgid ""
"Tells ScummVM that the MIDI device is an actual Roland MT-32, LAPC-I, CM-64, CM-32L, CM-500 or other MT-32 device."
msgstr ""
"當電腦的 MIDI 設備為 Roland MT-32、LAPC-I、CM-64、CM-32L、CM-500 或其他原生 MT-32 設備時，可啟用該選項，讓 ScummVM 禁用通用 MIDI 仿真。\n"
"不能與「啟用 Roland GS 設備」選項同時使用。"

#: lutris/runners/scummvm.py:431
msgid "Enable Roland GS"
msgstr "啟用 Roland GS 設備"

#: lutris/runners/scummvm.py:435
msgid ""
"Tells ScummVM that the MIDI device is a GS device that has an MT-32 map, such as an SC-55, SC-88 or SC-8820."
msgstr ""
"當電腦的 MIDI 設備是具有 MT-32 映射功能的 GS 設備，如 SC-55、SC-88 或 SC-8820 時，可啟用該選項，讓 ScummVM 啟用 MT-32 映射。\n"
"不能與「原生 Roland MT-32 設備」選項同時使用。"

#: lutris/runners/scummvm.py:443
msgid "Use alternate intro"
msgstr "使用替代介紹"

#: lutris/runners/scummvm.py:444
msgid "Uses alternative intro for CD versions"
msgstr "如果遊戲為人物準備了兩個版本的介紹，則播放另一種"

#: lutris/runners/scummvm.py:450
msgid "Copy protection"
msgstr "複製保護"

#: lutris/runners/scummvm.py:451
msgid "Enables copy protection"
msgstr "啟用複製保護"

#: lutris/runners/scummvm.py:457
msgid "Demo mode"
msgstr "演示模式"

#: lutris/runners/scummvm.py:458
msgid "Starts demo mode of Maniac Mansion or The 7th Guest"
msgstr "啟動 Maniac Mansion 和 The 7th Guest 的演示模式"

#: lutris/runners/scummvm.py:465
msgid "Debug level"
msgstr "調試級別"

#: lutris/runners/scummvm.py:466
msgid "Sets debug verbosity level"
msgstr "設定調試日誌的詳細級別（值為 --debuglevel=NUM 中的 NUM 部分）"

#: lutris/runners/scummvm.py:473
msgid "Debug flags"
msgstr "調試標誌"

#: lutris/runners/scummvm.py:474
msgid "Enables engine specific debug flags"
msgstr "新增引擎特定的調試標誌（值為 --debugflags=FLAGS 中的 FLAGS 部分）"

#: lutris/runners/shadps4.py:12
msgid "ShadPS4"
msgstr "ShadPS4"

