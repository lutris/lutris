#: lutris/runners/wine.py:291 lutris/runners/xenia.py:35
msgid "Wine prefix"
msgstr "容器目錄"

#: lutris/runners/wine.py:294
msgid ""
"The prefix used by Wine.\n"
"It's a directory containing a set of files and folders making up a confined Windows environment."
msgstr ""
"Wine 使用的「容器」（也稱為「Wine 前綴」）。\n"
"它是一個目錄，其中包含構成 Windows 兼容環境的一系列檔案和檔案夾。"

#: lutris/runners/wine.py:302 lutris/runners/xenia.py:41
msgid "Prefix architecture"
msgstr "容器架構"

#: lutris/runners/wine.py:304
msgid "32-bit"
msgstr "32位"

#: lutris/runners/wine.py:304 lutris/runners/xenia.py:42
msgid "64-bit"
msgstr "64位"

#: lutris/runners/wine.py:306
msgid "The architecture of the Windows environment"
msgstr "Windows 兼容環境的體系結構（32位或64位）"

#: lutris/runners/wine.py:311
msgid "Integrate system files in the prefix"
msgstr "在前綴中集成系統檔案"

#: lutris/runners/wine.py:315
msgid ""
"Place 'Documents', 'Pictures', and similar files in your home folder, instead of keeping them in the game's prefix. This includes some saved games."
msgstr "將「文檔」、「圖片」等類似檔案存放在您的主檔案夾中，而不是儲存在遊戲的前綴內。此操作會包含部分存檔檔案。"

#: lutris/runners/wine.py:324
msgid "Wine version"
msgstr "Wine 版本"

#: lutris/runners/wine.py:330
msgid ""
"The version of Wine used to launch the game.\n"
"Using the last version is generally recommended, but some games work better on older versions."
msgstr ""
"用於啟動遊戲的 Wine 版本。\n"
"通常建議使用最新版本，但是某些遊戲可能在舊版本上運行的更好。"

#: lutris/runners/wine.py:337
msgid "Custom Wine executable"
msgstr "自定義 Wine 路徑"

#: lutris/runners/wine.py:340
msgid ""
"The Wine executable to be used if you have selected \"Custom\" as the Wine version."
msgstr "如果您選擇「自定義」作為 Wine 版本，則將使用這裡指定的 Wine 可執行檔案。"

#: lutris/runners/wine.py:344
msgid "Use system winetricks"
msgstr "使用系統 winetricks"

#: lutris/runners/wine.py:348
msgid "Switch on to use /usr/bin/winetricks for winetricks."
msgstr "使用 /usr/bin/winetricks 而不是 Lutris 附帶的 winetricks。"

#: lutris/runners/wine.py:353
msgid "Enable DXVK"
msgstr "啟用 DXVK"

#: lutris/runners/wine.py:357
msgid "DXVK"
msgstr "DXVK"

#: lutris/runners/wine.py:360
msgid ""
"Use DXVK to increase compatibility and performance in Direct3D 11, 10 and 9 applications by translating their calls to Vulkan."
msgstr ""
"透過 DXVK 將 DX9/10/11 呼叫轉換為 Vulkan，可以顯著提高 DX9/10/11 遊戲在 Wine 中的幀率，也可以修復某些崩潰問題。"

#: lutris/runners/wine.py:368
msgid "DXVK version"
msgstr "DXVK 版本"

#: lutris/runners/wine.py:381
msgid "Enable VKD3D"
msgstr "啟用 VKD3D"

#: lutris/runners/wine.py:384
msgid "VKD3D"
msgstr "VKD3D"

#: lutris/runners/wine.py:387
msgid ""
"Use VKD3D to enable support for Direct3D 12 applications by translating their calls to Vulkan."
msgstr "透過 VKD3D 將 DX12 呼叫轉換為 Vulkan，可以使 DX12 遊戲在 Wine 中順利運行。"

#: lutris/runners/wine.py:392
msgid "VKD3D version"
msgstr "VKD3D 版本"

#: lutris/runners/wine.py:404
msgid "Enable D3D Extras"
msgstr "啟用 D3D 附加運行庫"

#: lutris/runners/wine.py:409
msgid ""
"Replace Wine's D3DX and D3DCOMPILER libraries with alternative ones. Needed for proper functionality of DXVK with some games."
msgstr "將 Wine 內建的 D3DX，D3DCOMPILER 等庫替換為原生版本。有些遊戲啟用 DXVK 時需要替換這些庫才能正常顯示。"

#: lutris/runners/wine.py:416
msgid "D3D Extras version"
msgstr "D3D 附加運行庫版本"

#: lutris/runners/wine.py:426
msgid "Enable DXVK-NVAPI / DLSS"
msgstr "啟用 DXVK-NVAPI / DLSS"

#: lutris/runners/wine.py:428
msgid "DXVK-NVAPI / DLSS"
msgstr "DXVK-NVAPI / DLSS"

#: lutris/runners/wine.py:432
msgid "Enable emulation of Nvidia's NVAPI and add DLSS support, if available."
msgstr "啟用來自 dxvk-nvapi 項目的 NVIDIA NVAPI 仿真，從而支援 DLSS（如果顯卡支援）。"

#: lutris/runners/wine.py:437
msgid "DXVK NVAPI version"
msgstr "DXVK NVAPI 版本"

#: lutris/runners/wine.py:448 lutris/sysoptions.py:241
msgid "Enable HDR (Experimental)"
msgstr "啟用 HDR（實驗性）"

#: lutris/runners/wine.py:454
msgid ""
"Enable Proton's support for High Dynamic Range graphics. Requires Wayland selected as Graphics backend."
msgstr "啟用 Proton 對高動態範圍圖形的支援。需要將 Wayland 選為圖形後端。"

#: lutris/runners/wine.py:460
msgid "Enable Esync"
msgstr "啟用 Esync"

#: lutris/runners/wine.py:466
msgid ""
"Enable eventfd-based synchronization (esync). This will increase performance in applications that take advantage of multi-core processors."
msgstr ""
"在 EXE 與 wineserver 進程（Wine 的核心）通信時啟用基於事件通知（eventfd）的同步（esync），可以提升多核遊戲的性能。"

#: lutris/runners/wine.py:473
msgid "Enable Fsync"
msgstr "啟用 Fsync"

#: lutris/runners/wine.py:479
msgid ""
"Enable futex-based synchronization (fsync). This will increase performance in applications that take advantage of multi-core processors. Requires kernel 5.16 or above."
msgstr ""
"在 EXE 與 wineserver 進程（Wine 的核心）通信時啟用基於快速使用者空間互斥鎖（futex）的同步（fsync），可以提升多核遊戲的性能。需要安裝 5.16 或更高版本的 Linux 核心。"

#: lutris/runners/wine.py:487
msgid "Enable AMD FidelityFX Super Resolution (FSR)"
msgstr "啟用 AMD 超級解析度銳畫技術（FSR）"

#: lutris/runners/wine.py:491
msgid ""
"Use FSR to upscale the game window to native resolution.\n"
"Requires Lutris Wine FShack >= 6.13 and setting the game to a lower resolution.\n"
"Does not work with games running in borderless window mode or that perform their own upscaling."
msgstr ""
"使用 FSR 將遊戲視窗放大到原始解析度。\n"
"需要 Lutris Wine FShack >= 6.13 版本並將遊戲設定為較低的解析度。\n"
"對無邊框視窗模式運行的遊戲或自帶解析度提升功能的遊戲無效。"

#: lutris/runners/wine.py:498
msgid "Enable BattlEye Anti-Cheat"
msgstr "啟用 BattlEye 反作弊支援"

#: lutris/runners/wine.py:502
msgid ""
"Enable support for BattlEye Anti-Cheat in supported games\n"
"Requires Lutris Wine 6.21-2 and newer or any other compatible Wine build.\n"
""
msgstr ""
"對遊戲啟用 BattlEye 反作弊支援（還需要遊戲開發者主動啟用 BattlEye proton 相容性支援，否則不會生效）。\n"
"需要使用 Lutris Wine 6.21-2 及後續版本，或者其他與 BattlEye 兼容的 Wine 版本。\n"
""

#: lutris/runners/wine.py:508
msgid "Enable Easy Anti-Cheat"
msgstr "啟用 EAC（小藍熊）反作弊支援"

#: lutris/runners/wine.py:512
msgid ""
"Enable support for Easy Anti-Cheat in supported games\n"
"Requires Lutris Wine 7.2 and newer or any other compatible Wine build.\n"
""
msgstr ""
"對遊戲啟用 Easy Anti-Cheat 反作弊支援（還需要遊戲開發者主動啟用 EAC proton 相容性支援，否則不會生效）。\n"
"需要使用 Lutris Wine 7.2 及後續版本，或者其他與 EAC 兼容的 Wine 版本。\n"
""

#: lutris/runners/wine.py:518 lutris/runners/wine.py:533
msgid "Virtual Desktop"
msgstr "虛擬桌面"

#: lutris/runners/wine.py:519
msgid "Windowed (virtual desktop)"
msgstr "視窗化（虛擬桌面）"

#: lutris/runners/wine.py:526
msgid ""
"Run the whole Windows desktop in a window.\n"
"Otherwise, run it fullscreen.\n"
"This corresponds to Wine's Virtual Desktop option."
msgstr ""
"在視窗中運行整個 Windows 桌面。\n"
"如果未啟用則全屏運行。\n"
"對應 Wine 的「虛擬桌面」選項。"

