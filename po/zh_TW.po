msgid ""
"<b>Warning</b> Lutris has detected that Vulkan API version %s is installed, but to use the latest DXVK version, %s is required."
msgstr "<b>警告</b> Lutris 偵測到已安裝 Vulkan API 版本 %s，但使用最新版 DXVK 需要版本 %s。"

#: lutris/runners/wine.py:175
