msgstr "Émulateur multi-système"

#: lutris/runners/libretro.py:218
msgid "Core"
msgstr "Cœur"

#: lutris/runners/libretro.py:227 lutris/runners/zdoom.py:76
msgid "Config file"
msgstr "Fichier de configuration"

#: lutris/runners/libretro.py:239
msgid "Verbose logging"
msgstr "Journalisation détaillée"

#: lutris/runners/libretro.py:312
