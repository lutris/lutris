{
    "name": "melonds",
    "human_name": "melonDS",
    "description": "Nintendo DS emulator",
    "platforms": ["Nintendo DS"],
    "runner_executable": "melonDS-x86_64.AppImage",
    "system_executable": "melonDS",
    "upstream": {"repo": "melonDS-emu/melonDS", "asset": "^melonDS-.*appimage-x86_64\\.zip$"},
    "upstream_arch": "x86_64",
    "runnable_alone": true,
    "game_options": [
        {
            "option": "main_file",
            "type": "file",
            "label": "ROM file",
            "help": "A DS ROM"
        }
    ],
    "runner_options": [
        {
            "option": "fullscreen",
            "type": "bool",
            "default": true,
            "label": "Fullscreen",
            "argument": "--fullscreen"
        }
    ]
}
