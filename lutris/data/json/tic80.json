{
    "name": "tic80",
    "human_name": "TIC-80",
    "description": "TIC-80 tiny computer",
    "platforms": ["TIC-80"],
    "runner_executable": "tic80",
    "system_executable": "tic80",
    "upstream": {"repo": "nesbox/TIC-80", "asset": "^tic80-.*-linux\\.zip$"},
    "upstream_arch": "x86_64",
    "game_options": [
        {
            "option": "main_file",
            "type": "file",
            "label": "ROM file"
        }
    ],
    "runner_options": [
        {
            "option": "fullscreen",
            "type": "bool",
            "label": "Start in fullscreen",
            "default": false,
            "argument": "--fullscreen"
        },
        {
            "option": "software_rendering",
            "type": "bool",
            "label": "Software rendering",
            "default": false,
            "argument": "--soft"
        },
        {
            "option": "skip",
            "type": "bool",
            "label": "Skip startup animation",
            "default": false,
            "argument": "--skip"
        },
        {
            "option": "nosound",
            "type": "bool",
            "label": "Start in silent mode",
            "default": false,
            "argument": "--volume=0"
        }
    ]
}
