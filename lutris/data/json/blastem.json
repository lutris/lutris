{
    "name": "blastem",
    "human_name": "BlastEm",
    "description": "Sega Genesis and Master System emulator",
    "platforms": ["Sega Genesis", "Sega Master System"],
    "runner_executable": "blastem",
    "system_executable": "blastem",
    "upstream": {"listing": "https://www.retrodev.com/blastem/nightlies/", "asset": "^blastem64-.*\\.tar\\.gz$"},
    "upstream_arch": "x86_64",
    "runnable_alone": true,
    "game_options": [
        {
            "option": "main_file",
            "type": "file",
            "label": "ROM file",
            "help": "The game data, commonly called a ROM image."
        }
    ],
    "runner_options": [
        {
            "option": "fullscreen",
            "type": "bool",
            "label": "Fullscreen",
            "default": true,
            "argument": "-f"
        }
    ]
}
