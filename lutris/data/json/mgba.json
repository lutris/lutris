{
    "name": "mgba",
    "human_name": "mGBA",
    "description": "Multi-system emulator: GBA & GB(C)",
    "platforms": [
        "Nintendo Game Boy Advance",
        "Nintendo Game Boy (Color)"
    ],
    "runner_executable": "mGBA-x64.AppImage",
    "system_executable": "mgba-qt",
    "upstream": {"repo": "mgba-emu/mgba", "asset": "^mGBA-.*-appimage-x64\\.appimage$"},
    "upstream_arch": "x86_64",
    "runnable_alone": true,
    "game_options": [
        {
            "option": "main_file",
            "type": "file",
            "label": "ROM file",
            "help": "A GBA or GB(C) ROM"
        }
    ]
}
